# Copy to .env.zitadel (git-ignored) and replace every CHANGE_ME_* value (./zitadel/create-db.sh refuses leftovers). Never commit real values.
# Do NOT define POSTGRES_* here: the base docker-compose.yml interpolates them and it would reconfigure relay's postgres.

ZITADEL_VERSION=v4.19.5
TRAEFIK_IMAGE=traefik:v3.7.7

# Browser-visible address. PROXY_HTTP_PUBLISHED_PORT and ZITADEL_EXTERNALPORT must match.
ZITADEL_DOMAIN=localhost
PROXY_HTTP_PUBLISHED_PORT=8081
ZITADEL_EXTERNALPORT=8081
ZITADEL_EXTERNALSECURE=false
ZITADEL_PUBLIC_SCHEME=http

# Exactly 32 chars: tr -dc A-Za-z0-9 </dev/urandom | head -c 32
# IMMUTABLE after first start. Back it up outside the repo.
ZITADEL_MASTERKEY=CHANGE_ME_32_CHARS_EXACTLY_xxxx

# openssl rand -base64 32
LOGIN_SESSION_COOKIE_SECRET=CHANGE_ME_openssl_rand_base64_32
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

# Database/role created by ./zitadel/create-db.sh on the existing postgres service.
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel
# openssl rand -hex 24
ZITADEL_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Bootstrap admin (zitadel-admin@zitadel.localhost). Needs 8+ chars, upper, lower, number, symbol.
ZITADEL_ADMIN_PASSWORD=CHANGE_ME_Aa1!_admin_password
